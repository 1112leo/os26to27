{
  "name": "os26to27",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler pages dev dist --port 8788",
    "dev:gate": "wrangler dev --config wrangler.ratelimit.jsonc --port 8789",
    "build": "npm run validate:public && npm run typecheck && vite build",
    "pretypecheck": "npm run types",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types --env-interface CloudflareBindings",
    "validate:public": "node scripts/public-data.mjs validate public/data/welcome.json",
    "publish:import": "node scripts/public-data.mjs import",
    "admin:setup": "node scripts/setup-admin.mjs",
    "qr": "node scripts/qr.mjs",
    "backup:sql": "node scripts/backup-to-sql.mjs",
    "deploy:gate": "wrangler deploy --config wrangler.ratelimit.jsonc",
    "deploy": "npm run build && npm run deploy:gate && wrangler pages deploy dist --project-name os26to27"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "miniflare": "5.20261023.0-beta",
    "qrcode": "1.5.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
