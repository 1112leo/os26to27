{
  "name": "os26to27",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "emulators": "firebase emulators:start --project demo-ohsung --only auth,firestore",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "build": "npm run validate:public && npm run typecheck && vite build && node scripts/pages-build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-ohsung --only auth,firestore \"vitest run --config vitest.firebase.config.ts\"",
    "firebase:deploy": "firebase deploy --only firestore:rules,firestore:indexes",
    "validate:public": "node scripts/public-data.mjs validate public/data/welcome.json",
    "publish:import": "node scripts/public-data.mjs import",
    "qr": "node scripts/qr.mjs",
    "backup:restore": "node scripts/firebase-restore.mjs"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.1",
    "qrcode": "1.5.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
