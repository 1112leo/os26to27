// Models: admins/{uid}: enabled + optional email (254), created_at; no self role writes.
// settings/event: phase A/B/C, updated_at, optional independent switches and activeChallengeId.
// challenges/{id}: text (1000), referenceKeystrokes (1..5000), practice/enabled, optional title/deleted.
// letters/{UUID}: private original + public edit/status/order, immutable owner/receipt/consent/timestamps.
// publicLetters/{UUID}: id, nickname, content, order, sort_order; sanitized approved projection only.
// typingResults/{UUID}: participant/name (30), challenge, time (<=1h), score, verification, prize, timestamps.
// receipts/{UUID} and rateLimits/{uid}: immutable receipt metadata and atomic device throttling.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function uuid(value) { return value is string && value.matches('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}'); }
    function eventOpen(kind) {
      let data = get(/databases/$(database)/documents/settings/event).data;
      return data.phase == 'A' && (kind == 'letter' ? data.get('submissionsEnabled', true) : data.get('typingEnabled', true));
    }
    function welcomeOpen() {
      let data = get(/databases/$(database)/documents/settings/event).data;
      return data.get('welcomeEnabled', data.phase == 'C');
    }
    function newReceipt(id, kind) {
      let receipt = getAfter(/databases/$(database)/documents/receipts/$(id)).data;
      return receipt.id == id && receipt.kind == kind && receipt.owner_uid == request.auth.uid && receipt.created_at == request.time;
    }
    function freshRate(id, kind) {
      let rate = getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data;
      return rate.last_event_id == id && rate.kind == kind && rate.last_write_at == request.time;
    }
    function text(value, minimum, maximum) {
      // RE2 counts Unicode code points, matching the form's Array.from counter.
      return value is string && value.matches('(?s).{' + string(minimum) + ',' + string(maximum) + '}')
        && value.trim() == value;
    }

    match /admins/{uid} {
      function valid(data) {
        return data.keys().hasAll(['enabled', 'email', 'created_at'])
          && data.keys().hasOnly(['enabled', 'email', 'created_at']) && data.enabled == true
          && text(data.email, 3, 254) && data.created_at is timestamp;
      }
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if admin() && request.auth.uid != uid && valid(request.resource.data) && request.resource.data.created_at == request.time;
      allow update: if false;
      allow delete: if admin() && request.auth.uid != uid;
    }
    match /settings/event {
      function valid(data) {
        return data.keys().hasAll(['phase', 'updated_at'])
          && data.keys().hasOnly(['phase', 'updated_at', 'typingEnabled', 'submissionsEnabled', 'welcomeEnabled', 'activeChallengeId'])
          && data.phase in ['A', 'B', 'C'] && data.updated_at == request.time
          && data.get('typingEnabled', true) is bool && data.get('submissionsEnabled', true) is bool
          && data.get('welcomeEnabled', false) is bool
          && (!('activeChallengeId' in data) || (text(data.activeChallengeId, 1, 100)
            && getAfter(/databases/$(database)/documents/challenges/$(data.activeChallengeId)).data.enabled == true
            && getAfter(/databases/$(database)/documents/challenges/$(data.activeChallengeId)).data.get('deleted', false) == false));
      }
      allow read: if true;
      allow create, update: if admin() && valid(request.resource.data);
      allow delete: if false;
    }
    match /challenges/{id} {
      function valid(data) {
        return id.matches('[a-zA-Z0-9_-]{1,100}')
          && data.keys().hasAll(['text', 'referenceKeystrokes', 'practice', 'enabled'])
          && data.keys().hasOnly(['text', 'referenceKeystrokes', 'practice', 'enabled', 'title', 'deleted'])
          && text(data.text, 1, 1000) && data.referenceKeystrokes is int && data.referenceKeystrokes > 0
          && data.referenceKeystrokes <= 5000 && data.practice is bool && data.enabled is bool
          && text(data.get('title', id), 1, 100) && data.get('deleted', false) is bool
          && (!data.get('deleted', false) || !data.enabled);
      }
      allow read: if true;
      allow create: if admin() && valid(request.resource.data);
      allow update: if admin() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'enabled', 'deleted'])
        && (request.resource.data.enabled || getAfter(/databases/$(database)/documents/settings/event).data.get('activeChallengeId', 'aegukga-verse1-practice-v1-floor0') != id);
      allow delete: if false;
    }
    match /rateLimits/{uid} {
      function shape() {
        let data = request.resource.data;
        return signedIn() && uid == request.auth.uid && data.keys().hasOnly(['window_start', 'count', 'last_write_at', 'last_event_id', 'kind'])
          && data.count is int && data.count > 0 && data.count <= 600 && data.window_start is timestamp
          && data.last_write_at == request.time && uuid(data.last_event_id) && data.kind in ['letter', 'typing']
          && newReceipt(data.last_event_id, data.kind);
      }
      allow get: if signedIn() && uid == request.auth.uid;
      allow create: if shape() && request.resource.data.window_start == request.time && request.resource.data.count == 1;
      allow update: if shape() && (
        (request.time - resource.data.window_start >= duration.value(60, 's')
          && request.resource.data.window_start == request.time && request.resource.data.count == 1)
        || (request.time - resource.data.window_start < duration.value(60, 's')
          && request.resource.data.window_start == resource.data.window_start && request.resource.data.count == resource.data.count + 1)
      );
      allow list, delete: if false;
    }
    match /receipts/{id} {
      function targetExists(data) {
        return data.kind == 'letter'
          ? getAfter(/databases/$(database)/documents/letters/$(id)).data.created_at == request.time
            && getAfter(/databases/$(database)/documents/letters/$(id)).data.owner_uid == request.auth.uid
          : getAfter(/databases/$(database)/documents/typingResults/$(id)).data.received_at == request.time
            && getAfter(/databases/$(database)/documents/typingResults/$(id)).data.owner_uid == request.auth.uid;
      }
      // Receipts contain only receipt metadata, never a student's original text or name.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/receipts/$(id)) || resource.data.owner_uid == request.auth.uid || admin());
      allow create: if signedIn() && uuid(id) && request.resource.data.keys().hasOnly(['id', 'owner_uid', 'kind', 'payload_hash', 'created_at'])
        && request.resource.data.id == id && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.kind in ['letter', 'typing'] && request.resource.data.created_at == request.time
        && request.resource.data.payload_hash is string && request.resource.data.payload_hash.matches('[0-9a-f]{64}')
        && targetExists(request.resource.data) && freshRate(id, request.resource.data.kind);
      allow list: if admin();
      allow update, delete: if false;
    }
    match /letters/{id} {
      function valid(data) {
        return data.keys().hasAll(['id', 'owner_uid', 'nickname', 'content', 'published_content', 'consent_to_publish', 'status', 'publish_order', 'submission_key', 'created_at', 'reviewed_at'])
          && data.keys().hasOnly(['id', 'owner_uid', 'nickname', 'content', 'published_content', 'consent_to_publish', 'status', 'publish_order', 'submission_key', 'created_at', 'reviewed_at'])
          && data.id == id && uuid(id) && text(data.content, 10, 700)
          && text(data.owner_uid, 1, 128) && data.created_at is timestamp && (data.reviewed_at == null || data.reviewed_at is timestamp)
          && (data.nickname == null || (text(data.nickname, 1, 30) && !data.nickname.matches('(?s).*\\n.*')))
          && data.consent_to_publish == 1 && data.submission_key == id
          && data.status in ['pending', 'approved', 'rejected']
          && (data.published_content == null || text(data.published_content, 1, 700))
          && (data.publish_order == null || (data.publish_order is int && data.publish_order >= 0 && data.publish_order <= 1000000));
      }
      function publicSynced(data) {
        return data.status == 'approved'
          ? getAfter(/databases/$(database)/documents/publicLetters/$(id)).data == projection(data)
          : !existsAfter(/databases/$(database)/documents/publicLetters/$(id));
      }
      allow read: if admin();
      allow create: if signedIn() && valid(request.resource.data)
        && request.resource.data.owner_uid == request.auth.uid && request.resource.data.created_at == request.time
        && ((admin() && request.resource.data.reviewed_at == request.time && publicSynced(request.resource.data))
          || (eventOpen('letter') && request.resource.data.status == 'pending' && request.resource.data.published_content == null
            && request.resource.data.publish_order == null && request.resource.data.reviewed_at == null && newReceipt(id, 'letter')));
      allow update: if admin() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'content', 'status', 'published_content', 'publish_order', 'reviewed_at'])
        && request.resource.data.reviewed_at == request.time && publicSynced(request.resource.data);
      allow delete: if admin() && !existsAfter(/databases/$(database)/documents/publicLetters/$(id));
    }
    function projection(data) {
      return {'id': data.id, 'nickname': data.nickname == null ? '익명' : data.nickname,
        'content': data.published_content == null ? data.content : data.published_content,
        'order': data.publish_order, 'sort_order': data.publish_order == null ? 1000001 : data.publish_order};
    }
    match /publicLetters/{id} {
      function valid(data) {
        let source = getAfter(/databases/$(database)/documents/letters/$(id)).data;
        return source.status == 'approved' && source.consent_to_publish == 1 && data == projection(source);
      }
      allow read: if admin() || welcomeOpen();
      allow create, update: if admin() && valid(request.resource.data);
      allow delete: if admin() && (!existsAfter(/databases/$(database)/documents/letters/$(id))
        || getAfter(/databases/$(database)/documents/letters/$(id)).data.status != 'approved');
    }
    match /typingResults/{id} {
      function validScore(data) {
        let challenge = get(/databases/$(database)/documents/challenges/$(data.challengeId)).data;
        // Force floating division even when elapsedMs was stored as an integer.
        let calculated = challenge.referenceKeystrokes * 60000.0 / data.elapsedMs;
        let rawScore = data.speed - data.errors * 20;
        return challenge.practice == data.practice
          && data.speed is int && data.speed >= 0 && data.speed - 0.5 <= calculated && calculated < data.speed + 0.5
          && data.errors is int && data.errors >= 0 && data.errors <= 10000
          && data.score is int && data.score == (rawScore > 0 ? rawScore : 0);
      }
      function valid(data) {
        return data.keys().hasAll(['id', 'owner_uid', 'participantId', 'displayName', 'challengeId', 'elapsedMs', 'speed', 'errors', 'score', 'completedAt', 'prizeReceived', 'practice', 'verificationStatus', 'received_at', 'reviewed_at'])
          && data.keys().hasOnly(['id', 'owner_uid', 'participantId', 'displayName', 'challengeId', 'elapsedMs', 'speed', 'errors', 'score', 'completedAt', 'prizeReceived', 'practice', 'verificationStatus', 'received_at', 'reviewed_at'])
          && data.id == id && uuid(id) && text(data.owner_uid, 1, 128)
          && text(data.participantId, 1, 30) && text(data.displayName, 1, 30)
          && text(data.challengeId, 1, 100) && data.challengeId.matches('[a-zA-Z0-9_-]+')
          && data.elapsedMs is number && data.elapsedMs > 0 && data.elapsedMs <= 3600000
          && data.completedAt is string && data.completedAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z') && data.completedAt.size() <= 30
          && data.received_at is timestamp && (data.reviewed_at == null || data.reviewed_at is timestamp)
          && data.prizeReceived is bool && data.practice is bool && data.verificationStatus in ['pending', 'verified', 'rejected']
          && (!data.prizeReceived || (!data.practice && data.verificationStatus == 'verified')) && validScore(data);
      }
      allow read: if admin();
      // Operators may recover queued booth records after the public event closes.
      allow create: if signedIn() && valid(request.resource.data)
        && request.resource.data.owner_uid == request.auth.uid && request.resource.data.received_at == request.time
        && ((admin() && request.resource.data.reviewed_at == request.time)
          || ((eventOpen('typing') || admin()) && request.resource.data.prizeReceived == false
            && request.resource.data.verificationStatus == 'pending' && request.resource.data.reviewed_at == null
            && get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.enabled == true
            && newReceipt(id, 'typing')));
      allow update: if admin() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantId', 'displayName', 'challengeId', 'practice', 'elapsedMs', 'speed', 'errors', 'score', 'prizeReceived', 'verificationStatus', 'reviewed_at'])
        && request.resource.data.reviewed_at == request.time;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
