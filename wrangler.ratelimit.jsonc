{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ohsung-rate-limiter",
  "main": "server/rate-limiter.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "262701", "simple": { "limit": 5, "period": 60 } },
    { "name": "SUBMIT_LIMITER", "namespace_id": "262702", "simple": { "limit": 600, "period": 60 } }
  ]
}
